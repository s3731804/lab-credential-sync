{
  "manifest_version": 3,
  "key": "",
  "name": "Lab Credential Sync",
  "version": "2.0",
  "description": "Unofficial companion for AWS Academy Learner Lab: syncs the CLI credentials you reveal to ~/.aws/credentials via a local helper.",

  "permissions": [
    "nativeMessaging",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.vocareum.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}
