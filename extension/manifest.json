{
  "manifest_version": 3,
  "name": "Lab Credential Sync",
  "version": "2.0",
  "description": "Unofficial companion for AWS Academy Learner Lab: syncs the CLI credentials you reveal to ~/.aws/credentials via a local helper.",

  "browser_specific_settings": {
    "gecko": {
      "id": "lab-credential-sync@williamjamesknights.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "nativeMessaging",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.vocareum.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ]
    }
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
